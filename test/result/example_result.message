,"cells":[{"location":{"line":29,"column":9},"value":"subscribe"}]},{"id":"ee6751bc-aa59-4b21-af22-5c3d65c95ef5","location":{"line":30,"column":7},"cells":[{"location":{"line":30,"column":9},"value":"unsubscribe"}]}]}]}},{"scenario":{"id":"d936cc52-48e6-42b0-aa4b-7aecf779801d","tags":[{"location":{"line":32,"column":3},"name":"@negative","id":"d3fda085-b6dd-421d-9dee-e8878208e846"}],"location":{"line":33,"column":3},"keyword":"Scenario Outline","name":"An invalid txn/on-status callback is rejected: <case>","description":"","steps":[{"id":"533c5d2d-974c-4043-88e6-a2682e2f7d29","location":{"line":34,"column":5},"keyword":"Given ","keywordType":"Context","text":"a valid request"},{"id":"1f5f4ea5-f316-45f8-a8e5-127a5f7484b5","location":{"line":35,"column":5},"keyword":"And ","keywordType":"Conjunction","text":"the request field \"<field>\" becomes '<value>'"},{"id":"6a52feae-759c-4d1c-b57d-8ad872b9b920","location":{"line":36,"column":5},"keyword":"When ","keywordType":"Action","text":"the request is sent"},{"id":"f64e05c5-8c9c-4df8-90ce-b51443d9b437","location":{"line":37,"column":5},"keyword":"Then ","keywordType":"Outcome","text":"the request should be rejected according to the DCI error model"}],"examples":[{"id":"41b37f86-d231-4600-b6ed-389f7da3a60b","tags":[],"location":{"line":39,"column":5},"keyword":"Examples","name":"","description":"","tableHeader":{"id":"07d586e0-5417-414b-817f-6d00793cef2e","location":{"line":40,"column":7},"cells":[{"location":{"line":40,"column":9},"value":"case"},{"location":{"line":40,"column":45},"value":"field"},{"location":{"line":40,"column":93},"value":"value"}]},"tableBody":[{"id":"e3338b74-6f6e-4263-8ec3-81b53e1b03d9","location":{"line":41,"column":7},"cells":[{"location":{"line":41,"column":9},"value":"missing header"},{"location":{"line":41,"column":45},"value":"header"},{"location":{"line":41,"column":93},"value":"<removed>"}]},{"id":"5abec108-6594-445d-85a2-e631d110eca1","location":{"line":42,"column":7},"cells":[{"location":{