:"filter type"}]},"tableBody":[{"id":"b6bbc175-0ead-47e5-9a7c-9a458397b94d","location":{"line":30,"column":7},"cells":[{"location":{"line":30,"column":9},"value":"live_birth"},{"location":{"line":30,"column":23},"value":"idtype-value"}]},{"id":"54e940a5-a119-45ff-aeb8-91523b640742","location":{"line":31,"column":7},"cells":[{"location":{"line":31,"column":9},"value":"death"},{"location":{"line":31,"column":23},"value":"idtype-value"}]},{"id":"2a941875-e8bb-4667-8c0a-db610684b3ec","location":{"line":32,"column":7},"cells":[{"location":{"line":32,"column":9},"value":"fetal_death"},{"location":{"line":32,"column":23},"value":"idtype-value"}]},{"id":"cd5e2c4c-248a-4aa7-b3af-56b3da79905d","location":{"line":33,"column":7},"cells":[{"location":{"line":33,"column":9},"value":"marriage"},{"location":{"line":33,"column":23},"value":"idtype-value"}]},{"id":"8f01fab0-aa97-48e5-9c1e-33f9d03e9030","location":{"line":34,"column":7},"cells":[{"location":{"line":34,"column":9},"value":"divorce"},{"location":{"line":34,"column":23},"value":"idtype-value"}]},{"id":"4025ca9e-ed8e-457e-b8c6-53698426c3ac","location":{"line":35,"column":7},"cells":[{"location":{"line":35,"column":9},"value":"adoption"},{"location":{"line":35,"column":23},"value":"idtype-value"}]}]},{"id":"8a1433bc-3d41-4015-8215-3925b43fa3e0","tags":[],"location":{"line":37,"column":5},"keyword":"Examples","name":"Namespaced event types (spec example form)","description":"","tableHeader":{"id":"fd19dcdf-2af8-4b9e-ada7-4f1bfb9d3702","location":{"line":38,"column":7},"cells":[{"location":{"line":38,"column":9},"value":"event"},{"location":{"line":38,"column":53},"value":"filter type"}]},"tableBody":[{"id":"89bcfc8c-b49d-4907-a402-38e23de622cc","location":{"line":39,"column":7},"cells":[{"location":{"line":39,"column":9},"value":"spdci-common:RegistryEventType:LiveBirth"},{"location":{"line":39,"column":53},"value":"predicate"}]},{"id":"9ed30c0a-de6c-4088-ad0a-e4e77f4d394b","location":{"line":40,"column":7},"cells":[{"locat