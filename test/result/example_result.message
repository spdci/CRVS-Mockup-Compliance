{"pickle":{"id":"3d9db3a4-2989-47ba-9666-ddbe05a4e789","uri":"features/crvs_on-unsubscribe.feature","astNodeIds":["c3cc5387-6d14-49cd-af8e-0e4c781c5811","ec139618-f42a-44ef-a2ea-3caddda90de2"],"name":"An invalid on-unsubscribe callback is rejected: missing timestamp","language":"en","steps":[{"id":"509a71cd-b75a-4230-b0ad-5d7cdd69fc53","text":"the \"on-unsubscribe\" endpoint","type":"Context","astNodeIds":["0bffdcab-7425-4f6f-88e5-747ab968d244"]},{"id":"0b2de0e1-880a-4c92-bbf8-1d0455d69bd3","text":"a valid request","type":"Context","astNodeIds":["12a6b3d0-cab6-4cb4-a756-f544691793c7","ec139618-f42a-44ef-a2ea-3caddda90de2"]},{"id":"1ea8ce02-cec5-443e-838e-b0a8789d0f1c","text":"the request field \"message.timestamp\" becomes '<removed>'","type":"Context","astNodeIds":["a386b217-d694-4561-a4dc-320324d27f02","ec139618-f42a-44ef-a2ea-3caddda90de2"]},{"id":"37497532-073c-4858-929c-0fcbdc9bec87","text":"the request is sent","type":"Action","astNodeIds":["1641489a-6ef2-46e5-9788-47b0afaa57cc","ec139618-f42a-44ef-a2ea-3caddda90de2"]},{"id":"369c779b-e7ad-43c7-8288-82737b3abd03","text":"the request should be rejected according to the DCI error model","type":"Outcome","astNodeIds":["327aece0-cc2a-4271-b1f8-0e6613ebd121","ec139618-f42a-44ef-a2ea-3caddda90de2"]}],"tags":[{"name":"@method=POST","astNodeId":"d22e5de7-5239-4f40-862f-26ea77f5a6df"},{"name":"@endpoint=crvs/on-unsubscribe","astNodeId":"82aae8db-867c-4cc1-9f1d-cf64c1b6b8d1"},{"name":"@negative","astNodeId":"a2e98a70-1222-4fc4-b949-fbee30bc8a94"}]}}
