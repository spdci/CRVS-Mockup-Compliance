c77-bee8-43a6-83fb-e32de5e71b2b","location":{"line":30,"column":7},"cells":[{"location":{"line":30,"column":9},"value":"search"},{"location":{"line":30,"column":23},"value":"transaction_id"}]},{"id":"cc449a8a-27aa-4724-8b2c-aaef3b4827f9","location":{"line":31,"column":7},"cells":[{"location":{"line":31,"column":9},"value":"search"},{"location":{"line":31,"column":23},"value":"reference_id_list"}]},{"id":"7bd12974-e3cf-440e-9c61-ce6dcd110977","location":{"line":32,"column":7},"cells":[{"location":{"line":32,"column":9},"value":"search"},{"location":{"line":32,"column":23},"value":"correlation_id"}]},{"id":"f416573e-cdd3-43f4-acb6-72ba2cb71405","location":{"line":33,"column":7},"cells":[{"location":{"line":33,"column":9},"value":"subscribe"},{"location":{"line":33,"column":23},"value":"transaction_id"}]},{"id":"44fe396a-35a4-488f-a358-41cc0b3fc4fb","location":{"line":34,"column":7},"cells":[{"location":{"line":34,"column":9},"value":"subscribe"},{"location":{"line":34,"column":23},"value":"subscription_code_list"}]},{"id":"79189c61-577c-4545-82e6-022907dfc024","location":{"line":35,"column":7},"cells":[{"location":{"line":35,"column":9},"value":"unsubscribe"},{"location":{"line":35,"column":23},"value":"subscription_code_list"}]},{"id":"962a28e8-91e3-4b2c-9b2b-e07489e5cd0f","location":{"line":36,"column":7},"cells":[{"location":{"line":36,"column":9},"value":"unsubscribe"},{"location":{"line":36,"column":23},"value":"correlation_id"}]}]}]}},{"scenario":{"id":"50ef9e93-041a-4d5c-a1bc-ecb885bd2291","tags":[{"location":{"line":38,"column":3},"name":"@callback","id":"f030e870-67f3-4d3d-b11f-6ca8f37b7440"}],"location":{"line":39,"column":3},"keyword":"Scenario Outline","name":"The status of a <txn type> transaction is delivered to the txn/on-status callback","description":"","steps":[{"id":"c1894d9f-53a1-40a9-90e9-47417a3996dd","location":{"line":40,"column":5},"keyword":"Given ","keywordType":"Context","text":"a transaction status request for \"<txn type>\" transactions b